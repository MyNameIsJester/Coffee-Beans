</mxCell><mxCell id="c86" value="Lỗi (đỏ): Dòng 2: vui lòng chọn sản phẩm. / số lượng phải là số nguyên lớn hơn 0. / sản phẩm bị trùng trong cùng phiếu." style="html=1;text;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#C62828;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="980" width="876" height="18" as="geometry"/></mxCell><mxCell id="c87" value="Hủy" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4B3429;strokeWidth=1;fontColor=#4B3429;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="950" y="1054" width="100" height="38" as="geometry"/></mxCell><mxCell id="c88" value="Lưu phiếu" style="html=1;whiteSpace=wrap;fillColor=#4B3429;strokeColor=#4B3429;strokeWidth=1;fontColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;rounded=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1060" y="1054" width="100" height="38" as="geometry"/></mxCell><mxCell id="c89" value="① Tìm theo mã phiếu hoặc tên sản phẩm, khoảng ngày nhập, trạng thái. Khoảng ngày sai (từ &amp;gt; đến) báo lỗi." style="html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#5C4B00;fontSize=11;align=left;verticalAlign=top;rounded=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="130" width="250" height="130" as="geometry"/></mxCell><mxCell id="c90" value="② Phiếu nhập nhiều sản phẩm, không quản lý nhà cung cấp. Chỉ sửa/xóa được phiếu chưa hoàn thành." style="html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#5C4B00;fontSize=11;align=left;verticalAlign=top;rounded=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="274" width="250" height="150" as="geometry"/></mxCell><mxCell id="c91" value="③ ✅ Hoàn thành: cộng tồn kho đúng một lần, cập nhật giá vốn bình quân và khóa phiếu." style="html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontCol