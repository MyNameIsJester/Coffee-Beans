, sửa, ẩn, xóa. Trùng tên (không phân biệt hoa thường) bị từ chối. Ẩn loại sẽ ẩn luôn các sản phẩm thuộc loại khỏi khách hàng." style="html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#5C4B00;fontSize=11;align=left;verticalAlign=top;rounded=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="130" width="250" height="150" as="geometry"/></mxCell><mxCell id="c62" value="② Loại còn sản phẩm không xóa được: hiện thông báo như hộp thoại bên trái." style="html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1;fontColor=#5C4B00;fontSize=11;align=left;verticalAlign=top;rounded=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="294" width="250" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-16" name="15 Admin - Sản phẩm"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#BDBDBD;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="1160" as="geometry"/></mxCell><mxCell id="c3" value="" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#CFCFCF;strokeWidth=1;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="60" as="geometry"/></mxCell><mxCell id="c4" value="☕  Cà Phê Đậm Đà - Admin" style="html=1;text;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="320" height="36" as="geometry"/></mxCell><mxCell id="c5" value="Q" style="html=1;whiteSpace=wrap;fillColor=#4B342